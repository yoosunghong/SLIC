\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:architecture}{{1}{4}{SLIC architecture (Condition~1 --- Full). Four entity token groups are encoded by dedicated linear layers. Intra-Set Self-Attention contextualises each entity set independently. Cross-Attention uses the self-embedding as query and each set as key/value. Red arrows highlight the role-conditioned routing path: the role one-hot in \texttt {self\_tok} is projected into Q, while the role one-hots in \texttt {ally\_tok} are projected into K/V, enabling structured role-pair attention routing without architectural hand-coding}{figure.caption.1}{}}
\newlabel{sec:experiments}{{5}{5}{}{section.5}{}}
\newlabel{tab:track1}{{1}{5}{Track 1 performance on SMACv2. Win rate is the mean of final evaluation checkpoints}{table.caption.2}{}}
\newlabel{fig:win_rate_curves}{{2}{5}{Learning curves for all five conditions over 2M training steps. The full attention condition converges highest, while removing intra-set self-attention or removing role labels lowers performance}{figure.caption.3}{}}
\newlabel{tab:delta_max}{{2}{5}{$\Delta _{\max }$ per role for Condition~1. Condition~2 is omitted because $\Delta _{\max }$ is not defined once ally self-attention is removed}{table.caption.4}{}}
\newlabel{tab:routing}{{3}{6}{Role-routing matrix for Condition~1. Entry $(i,j)$ is the mean cross-attention weight assigned by role $i$ to ally slots occupied by role $j$. Diagonal entries are zero by construction}{table.caption.5}{}}
\newlabel{tab:gradient}{{4}{6}{Gradient attribution for the Role+MLP baseline (Condition~3). Spatial/Role ratio $\gg 1$ indicates role dimensions contribute less signal than spatial features to the output}{table.caption.6}{}}
